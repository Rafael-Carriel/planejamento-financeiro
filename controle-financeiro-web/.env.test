# Variáveis do ambiente de testes E2E (Playwright).
#
# As chaves do Firebase abaixo são fictícias: os testes substituem o SDK real
# por dublês em memória (ver `tests/support/mocks`), então nada aqui acessa o
# projeto de produção nem guarda segredo. Elas servem apenas para o app iniciar
# sem cair na tela de configuração.
#
# As credenciais `E2E_*` são opcionais: os padrões estão em
# `tests/support/constantes.ts` e são sobrescritos por estas variáveis.

VITE_FIREBASE_API_KEY=chave-ficticia-de-teste
VITE_FIREBASE_AUTH_DOMAIN=controle-financeiro-teste.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=controle-financeiro-teste
VITE_FIREBASE_STORAGE_BUCKET=controle-financeiro-teste.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

E2E_EMAIL=ana.teste@planejamento.local
E2E_SENHA=senha-de-teste
E2E_NOME=Ana Teste
