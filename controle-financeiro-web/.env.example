# Configuração do app web no Firebase.
#
# Copie este arquivo para `.env.local` e preencha com os dados do seu app web.
# O jeito mais rápido é rodar `.\configurar-web.ps1`, que registra o app web no
# projeto e gera o `.env.local` já preenchido.
#
# Para pegar à mão: console.firebase.google.com > Configurações do projeto >
# Seus apps > app da Web > Configuração do SDK.
#
# Estas chaves são públicas por natureza (vão no bundle do navegador). Quem
# protege os dados são as regras do Firestore, não o segredo da chave.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=controle-financeiro-rafael.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=controle-financeiro-rafael
VITE_FIREBASE_STORAGE_BUCKET=controle-financeiro-rafael.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=652229071618
VITE_FIREBASE_APP_ID=
