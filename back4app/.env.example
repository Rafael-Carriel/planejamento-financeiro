# Back4App: cadastre como variáveis de ambiente do servidor. Nunca use VITE_ nestas chaves.
ASAAS_ENV=sandbox
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
FIREBASE_SERVICE_ACCOUNT_JSON=
# UID do Firebase Auth do proprietário, separado por vírgula para mais de um.
ADMIN_UIDS=
# Obrigatório: monthly (inserções por mês) ou lifetime (inserções acumuladas).
USAGE_MODE=lifetime
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
